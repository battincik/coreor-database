# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Zorunlu ve kurulumlar arasında sabit kalmalı.
# Üretmek için:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Next.js sunucusunun bağlanmasına izin verilen MySQL/MariaDB hedefleri.
DATABASE_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_ALLOWED_PORTS=3306
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_MAX_RESULT_ROWS=5000

# Tablo veri ekranında tek istekte alınabilecek en yüksek sayfa boyutu.
DATABASE_MAX_PAGE_SIZE=500
