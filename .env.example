# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Zorunlu ve kurulumlar arasında sabit kalmalı.
# Üretmek için:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Üretimde varsayılan olarak yalnızca açıkça izin verilen GitHub kullanıcı ID'leri giriş yapabilir.
# GitHub numeric user ID'lerini virgülle ayırın. Örn: 51765819
AUTH_ALLOWED_GITHUB_IDS=
AUTH_REQUIRE_GITHUB_ALLOWLIST=true

# NEXTAUTH_URL dışında ek güvenilir origin gerekiyorsa virgülle ayırın.
# Örn: https://preview.example.com,https://database.example.com
AUTH_TRUSTED_ORIGINS=

# Yenilikler sayfasının okuyacağı GitHub repository.
# Public repository için token zorunlu değildir. Token eklenirse API limiti yükselir
# ve private repository sürüm geçmişi de okunabilir.
COREOR_RELEASES_REPOSITORY=battincik/web.database.coreor.net
GITHUB_RELEASES_TOKEN=

# Next.js sunucusunun bağlanmasına izin verilen veritabanı hedefleri.
# Üretimde DATABASE_REQUIRE_HOST_ALLOWLIST=true iken * kullanılamaz ve yalnızca
# burada açıkça tanımlanan hostlar kullanılabilir.
# MySQL/MariaDB: 3306, TiDB: 4000, PostgreSQL: 5432,
# CockroachDB: 26257, Microsoft SQL Server: 1433
DATABASE_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_ALLOWED_PORTS=3306,4000,5432,26257,1433
DATABASE_REQUIRE_HOST_ALLOWLIST=true
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_MAX_RESULT_ROWS=5000

# /api/database için kullanıcı başına temel process-local dakikalık limit.
# Dağıtık/serverless kurulumlarda edge/WAF veya merkezi rate-limit ile desteklenmelidir.
DATABASE_RATE_LIMIT_REQUESTS=300

# Tablo veri ekranında tek istekte alınabilecek en yüksek sayfa boyutu.
DATABASE_MAX_PAGE_SIZE=500

# TEXT/BLOB dosya yüklemeleri dahil /api/database gövdesinin bayt sınırı.
# Sunucu tarafında 1 MB ile 25 MB arasına sıkıştırılır; UI dosya seçiminde 6 MB sınırı uygular.
DATABASE_API_MAX_BODY_BYTES=12000000
