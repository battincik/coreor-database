{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Coreor Database cross-platform native window permissions",
  "windows": [
    "main",
    "updater"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ]
}
