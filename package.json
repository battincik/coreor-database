{
  "name": "coreor-database",
  "version": "26.9.4",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run tauri:dev",
    "ui:dev": "node scripts/clean-next-cache.mjs && next dev --turbopack",
    "build": "npm run tauri:build",
    "ui:build": "node scripts/clean-next-cache.mjs && tsc --noEmit && next build --turbopack",
    "tauri": "tauri",
    "tauri:dev": "npm run icons:ensure && tauri dev",
    "tauri:build": "npm run icons:ensure && tauri build",
    "build:windows": "npm run icons:ensure && tauri build --bundles nsis,msi",
    "build:linux": "npm run icons:ensure && tauri build --bundles deb,rpm,appimage",
    "build:macos": "npm run icons:ensure && tauri build --bundles app,dmg",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "native:check": "npm run icons:ensure && cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "i18n:check": "npm run i18n:registry:check && node scripts/validate-locales.mjs",
    "architecture:check": "node scripts/assert-native-client.mjs",
    "check": "npm run test:lifecycle && npm run test:updater && npm run locks:check && npm run architecture:check && npm run i18n:check && npm run i18n:audit && npm run lint && npm run typecheck && npm run ui:build && npm run native:check",
    "locks:generate": "node scripts/prepare-lockfiles.mjs",
    "locks:check": "node scripts/assert-lockfiles.mjs",
    "profile:windows": "npm run profile",
    "icons:generate": "tauri icon src-tauri/icons/app-icon.svg",
    "icons:ensure": "node scripts/ensure-icons.mjs",
    "profile": "node scripts/profile-desktop.mjs",
    "i18n:audit": "node scripts/audit-i18n.mjs",
    "i18n:generate": "node scripts/generate-locale-registry.mjs",
    "i18n:registry:check": "node scripts/generate-locale-registry.mjs --check",
    "i18n:audit:strict": "node scripts/audit-i18n.mjs --strict-direct",
    "test:lifecycle": "node --test tests/app-lifecycle.test.mjs",
    "test:updater": "node --test tests/updater-manifest.test.mjs",
    "version:prepare": "node scripts/version-prepare.mjs",
    "release:local": "node scripts/local-release.mjs",
    "release:local:install": "node scripts/local-release.mjs --install",
    "release:local:signed": "node scripts/local-release.mjs --signed"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-table": "^8.21.2",
    "@tauri-apps/api": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "motion": "^12.6.3",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.0"
  },
  "description": "Cross-platform, local-first database client built with Tauri, Rust, React and Next.js.",
  "license": "Apache-2.0",
  "author": "Coreor contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/battincik/coreor-database.git"
  },
  "bugs": {
    "url": "https://github.com/battincik/coreor-database/issues"
  },
  "homepage": "https://github.com/battincik/coreor-database#readme",
  "keywords": [
    "database-client",
    "database-management",
    "sql",
    "tauri",
    "rust",
    "mysql",
    "mariadb",
    "postgresql",
    "mssql",
    "tidb",
    "cockroachdb",
    "cross-platform"
  ]
}
