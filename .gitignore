# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build/test output
/coverage
/.next/
/out/
/build
/src-tauri/target/
/local-releases/

# generated desktop icon derivatives
# app-icon.svg is the source of truth. icon.ico stays tracked because
# tauri-build needs it during Windows Cargo hot rebuilds.
src-tauri/icons/*.png
src-tauri/icons/*.icns

# OS/editor
.DS_Store
Thumbs.db

# local application/developer data
config.json
*.local.json
*.pem
*.key
*.p12
*.pfx

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local DB usage does not require environment files.
# Never commit account-provider, signing or release secrets.
.env*
