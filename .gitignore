# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local desktop configuration
config.json
*.local.json

# tauri
/src-tauri/target/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# environment files are not used by desktop client, never commit them
.env*
!.env.example.disabled
